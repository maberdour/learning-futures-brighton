---
import type { Event } from '../types';
import nextEvent from '../data/next-event.json';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
const files=import.meta.glob<Event>('../data/events/*.json',{eager:true,import:'default'});
const events=Object.entries(files).map(([path,event])=>({slug:path.split('/').pop().replace('.json',''),event})).sort((a,b)=>b.event.date.localeCompare(a.event.date)).slice(0,3);
---
<Base title="Home"><div class="wrap hero" id="home"><div class="eyebrow">Brighton · Learning · Technology · Design</div><h1>Fresh ideas.<br/>Real connections.</h1><p class="lead">Connecting Brighton’s learning, tech and design communities through inspiring talks, thoughtful conversations and shared ideas.</p><div class="actions"><a class="pill dark" href="#next-event">Next Event ↓</a><a class="pill" href="#about">Discover the community ↓</a></div><img class="banner" src="/images/banner.jpg" alt="Original Learning Futures Brighton skyline artwork"/></div>
<section id="next-event"><div class="wrap"><div class="sectionhead"><h2>Next Event</h2></div>{nextEvent.enabled ? <div><h3>{nextEvent.title}</h3><p>{nextEvent.dateLabel || nextEvent.date}</p><p>{nextEvent.venue}</p><p class="lead">{nextEvent.summary}</p><div class="speaker-grid">{[nextEvent.speaker1,nextEvent.speaker2,nextEvent.speaker3].map((speaker,i)=><article class="speaker-card"><div class="eyebrow">Talk {i+1}</div><h3>{speaker.name}</h3><strong>{speaker.talkTitle}</strong><p>{speaker.description}</p><div class="resource-links">{speaker.slides&&<a href={speaker.slides} target="_blank" rel="noopener noreferrer">Download slides ↗</a>}{speaker.videoUrl&&<a href={speaker.videoUrl} target="_blank" rel="noopener noreferrer">Watch recording ↗</a>}</div></article>)}</div>{nextEvent.lumaUrl&&<p><a class="pill dark" href={nextEvent.lumaUrl} target="_blank" rel="noopener noreferrer">Book on Luma ↗</a></p>}</div> : <div class="embed-placeholder"><div class="eyebrow">Luma embed placeholder</div><h3>Upcoming event</h3><p>The Luma event calendar will appear here. Event details and registration will be managed directly through Luma.</p><a class="pill dark" href="https://luma.com/futuresbri" target="_blank" rel="noopener noreferrer">See upcoming events on Luma ↗</a></div>}</div></section>
<section id="past-events"><div class="wrap"><div class="sectionhead"><h2>Past Events</h2><a href="/past-events/">View all past events →</a></div><div class="grid">{events.map(({slug,event})=><EventCard event={event} slug={slug}/>)}</div></div></section>
<section id="about"><div class="wrap"><div class="sectionhead"><h2>Ideas worth sharing.<br/>People worth meeting.</h2></div><p class="lead">Learning Futures Brighton brings together people working across learning, technology and design. We create space for new perspectives, practical insights and connections across disciplines.</p><div class="grid"><div class="tile"><span class="num">01 / DISCOVER</span><h3>Fresh thinking</h3><p>Hear different perspectives on how people learn and how technology is changing our work.</p></div><div class="tile"><span class="num">02 / DISCUSS</span><h3>Open conversation</h3><p>Ask questions, exchange experiences and challenge assumptions in a friendly setting.</p></div><div class="tile"><span class="num">03 / CONNECT</span><h3>Local community</h3><p>Meet people from Brighton and beyond who share your curiosity about learning.</p></div></div></div></section>
<section id="community" class="band"><div class="wrap"><div class="eyebrow" style="color:#ff819b">Stay connected</div><div class="sectionhead"><h2>Be part of the conversation.</h2></div><p>Follow Learning Futures Brighton on LinkedIn for news and community updates, and find our upcoming meetups on Luma.</p><div class="actions"><a class="pill" href="https://www.linkedin.com/company/learning-futures-brighton" target="_blank" rel="noopener noreferrer">Follow on LinkedIn ↗</a><a class="pill" href="https://luma.com/futuresbri" target="_blank" rel="noopener noreferrer">Find an event ↗</a></div></div></section></Base>
