---
const root=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
const destination=root+'#past-events';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta http-equiv="refresh" content={`0;url=${destination}`}/><link rel="canonical" href={destination}/><title>Past Events | Learning Futures Brighton</title></head><body><p>Past events are now on the <a href={destination}>homepage</a>.</p></body></html>
