---
import type { Event } from '../../types';
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){const files=import.meta.glob<Event>('../../data/events/*.json',{eager:true,import:'default'});return Object.entries(files).map(([path,event])=>({params:{slug:path.split('/').pop().replace('.json','')},props:{event}}));}
const {event}=Astro.props;
const date=event.dateLabel || new Date(`${event.date}T12:00:00`).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
const speakers=[event.speaker1,event.speaker2,event.speaker3];
const root=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
const sponsors = [event.sponsoredBy, event.sponsoredBy2, event.sponsoredBy3].filter(partner => partner?.name || partner?.logo || partner?.url);
const partners = [
  { label: 'Hosted by', entries: event.hostedBy?.name || event.hostedBy?.logo || event.hostedBy?.url ? [event.hostedBy] : [] },
  { label: 'Sponsored by', entries: sponsors },
  { label: 'Supported by', entries: event.supportedBy?.name || event.supportedBy?.logo || event.supportedBy?.url ? [event.supportedBy] : [] },
].filter(({entries}) => entries.length > 0);
const logoUrl=(url: string | undefined) => url?.startsWith('/resources/') ? root + url.slice(1).split('/').map(encodeURIComponent).join('/') : (url || '');
const resourceUrl=(url: string | undefined) => {
  if (!url) return '';
  if (url.startsWith('/resources/')) return root + url.slice(1).split('/').map(encodeURIComponent).join('/');
  return url;
};
---
<Base title={event.title}><div class="wrap pagehead"><div class="eyebrow">Past Event · {date}</div><h1>{event.title}</h1><p class="lead">{event.summary}</p><a class="pill" href={event.lumaUrl} target="_blank" rel="noopener noreferrer">Original Luma event ↗</a></div><section><div class="wrap"><div class="sectionhead"><h2>Speakers and talks</h2></div><div class="speaker-grid">{speakers.map((speaker,i)=><article class="speaker-card"><div class="eyebrow">Talk {i+1}</div><h2>{speaker.name}</h2><strong>{speaker.talkTitle}</strong><p>{speaker.description}</p>{(speaker.slides||speaker.videoUrl)&&<div class="resource-links">{speaker.slides&&<a class="pill" href={resourceUrl(speaker.slides)} target="_blank" rel="noopener noreferrer">Download slides ↗</a>}{speaker.videoUrl&&<a href={speaker.videoUrl} target="_blank" rel="noopener noreferrer">Watch recording ↗</a>}</div>}</article>)}</div>{partners.length > 0 && <div class="partner-grid">{partners.map(({label,entries}) => <div class="partner-card"><div class="eyebrow">{label}</div><div class="partner-entries">{entries.map(partner => partner.url ? <a class="partner-link" href={partner.url} target="_blank" rel="noopener noreferrer">{partner.logo && <img src={logoUrl(partner.logo)} alt={partner.name ? `${partner.name} logo` : `${label} logo`} loading="lazy" />}{partner.name && <strong>{partner.name}</strong>}</a> : <div class="partner-link">{partner.logo && <img src={logoUrl(partner.logo)} alt={partner.name ? `${partner.name} logo` : `${label} logo`} loading="lazy" />}{partner.name && <strong>{partner.name}</strong>}</div>)}</div></div>)}</div>}<p><a href={root+'#past-events'}>← All past events</a></p></div></section></Base>
